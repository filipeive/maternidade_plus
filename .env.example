APP_NAME="Maternidade Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maternidade_plus
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# AI Configuration (OpenRouter / Gemini)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# SMS Configuration (httpSMS)
SMS_DRIVER=httpsms
HTTPSMS_KEY=
HTTPSMS_FROM=+258862134230

VITE_APP_NAME="${APP_NAME}"
